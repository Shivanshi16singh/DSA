#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    string infixToPostfix(string s) {
        stack <int> st;
        string ans="";
        for(int i=0; i<s.size(); i++){
            if((s[i]>='A' && s[i]<='Z') || (s[i]>='a' && s[i] <='z') || (s[i]>='0' && s[i]<='9')){
                ans+= s[i];
            }else if(s[i]=='('){
                st.push(s[i]);
            }else if(s[i]==')'){
                while(st.top()!='(' && !st.empty() ){
                    ans+= st.top();
                    st.pop();
                }
                st.pop();
            }else {
                if(st.empty()){
                    st.push(s[i]);
                }
                else if(p(s[i]>p(st.top()))){
                    st.push(s[i]);
                }else{
                    while(p(s[i])>p(st.top())){
                        ans+= st.top();
                        st.pop();
                    }
                }
            }
        }
        while(!st.empty()){
            ans+= st.top();
            st.pop();
        }
        return ans;
    }
    int p(char ch){
        if(ch=='^') return 3;
        else if(ch=='*' || ch=='/') return 2;
        else if(ch=='+' || ch=='-') return 1;
        return -1;
    }
};